@{
    ViewBag.Title = "Dashboard";
    ViewBag.FullWidthContent = true;
    Layout = "~/Views/Shared/_Layout.cshtml";

    var inProcessApplications = ViewBag.InProcessApplications as IEnumerable<dynamic> ?? new List<dynamic>();
    var approvedUpcomingApplications = ViewBag.ApprovedUpcomingApplications as IEnumerable<dynamic> ?? new List<dynamic>();
    var approvedFinishedApplications = ViewBag.ApprovedFinishedApplications as IEnumerable<dynamic> ?? new List<dynamic>();
    var disapprovedApplications = ViewBag.DisapprovedApplications as IEnumerable<dynamic> ?? new List<dynamic>();
    var allDashboardApplications = inProcessApplications
        .Concat(approvedUpcomingApplications)
        .Concat(approvedFinishedApplications)
        .Concat(disapprovedApplications)
        .ToList();
}

@functions {
    public string GetStatusBadgeClass(short? status)
    {
        switch (status)
        {
            case 2:
                return "badge-primary";
            case 3:
            case 4:
                return "badge-warning";
            case 5:
                return "badge-success";
            case 0:
                return "badge-danger";
            default:
                return "badge-secondary";
        }
    }
}

@helper RenderApplicationTable(IEnumerable<dynamic> applications, string emptyText, bool showSchedule)
{
    if (!applications.Any())
    {
        <div class="text-muted p-3">@emptyText</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover mb-0">
                <thead>
                    <tr>
                        <th>Date Applied</th>
                        <th>Leave Detail</th>
                        <th>Inclusive Dates</th>
                        <th class="text-center">Total Days</th>
                        <th class="text-center">Status</th>
                    @if (showSchedule)
                    {
                        <th class="text-center">Schedule</th>
                    }
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                    @foreach (var application in applications)
                    {
                        <tr>
                            <td>@application.DateApplied</td>
                            <td>@application.LeaveDetail</td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(application.InclusiveDates))
                                {
                                    <span class="badge badge-secondary">No dates</span>
                                }
                                else
                                {
                                    @application.InclusiveDates
                                }
                            </td>
                            <td class="text-center">@application.TotalNumberOfDays</td>
                            <td class="text-center">
                                <span class="badge @GetStatusBadgeClass(application.Status)">@application.StatusText</span>
                            </td>
                            @if (showSchedule)
                            {
                            <td class="text-center">
                                <span class="badge @application.ScheduleBadgeClass">@application.ScheduleText</span>
                            </td>
                        }
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-primary dashboard-view-application" title="View Application" data-toggle="modal" data-target="#modal-dashboard-application" data-application-id="@application.LeaveApplicationID" onclick="window.openDashboardApplication(@application.LeaveApplicationID)">
                                <i class="fas fa-eye"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
            </table>
        </div>
    }
}

<style>
