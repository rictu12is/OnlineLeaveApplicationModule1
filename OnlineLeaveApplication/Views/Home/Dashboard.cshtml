<div class="row dashboard-shell">
    <div class="col-12">
        <h2>Dashboard</h2>

        <div class="row">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="small-box bg-primary">
                    <div class="inner">
                        <h3>@ViewBag.ForCertification</h3>
                        <p>Received</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-stamp"></i>
                    </div>
                    <a href="#dashboard-in-process" class="small-box-footer dashboard-filter-link" data-dashboard-status="2" data-dashboard-label="Received" onclick="window.renderDashboardFocusedResults(2, 'Received'); return false;">More info <i class="fas fa-link"></i></a>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="small-box bg-warning">
                    <div class="inner">
                        <h3>@ViewBag.ForReview</h3>
                        <p>For Review</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-file-signature"></i>
                    </div>
                    <a href="#dashboard-in-process" class="small-box-footer dashboard-filter-link" data-dashboard-status="3" data-dashboard-label="For Review" onclick="window.renderDashboardFocusedResults(3, 'For Review'); return false;">More info <i class="fas fa-link"></i></a>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="small-box bg-success">
                    <div class="inner">
                        <h3>@ViewBag.Approved</h3>
                        <p>Approved</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-thumbs-up"></i>
                    </div>
                    <a href="#dashboard-focused-results" class="small-box-footer dashboard-filter-link" data-dashboard-status="5" data-dashboard-label="Approved" onclick="window.renderDashboardFocusedResults(5, 'Approved'); return false;">More info <i class="fas fa-link"></i></a>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="small-box bg-danger">
                    <div class="inner">
                        <h3>@ViewBag.Disapproved</h3>
                        <p>Disapproved</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-thumbs-down"></i>
                    </div>
                    <a href="#dashboard-focused-results" class="small-box-footer dashboard-filter-link" data-dashboard-status="0" data-dashboard-label="Disapproved" onclick="window.renderDashboardFocusedResults(0, 'Disapproved'); return false;">More info <i class="fas fa-link"></i></a>
                </div>
            </div>
        </div>
    </div>
</div>

